parts {
    // Microcontrollers
    STM32H747XIH6 { mpns "STM32H747XIH6" "STM32H747XIH6TR" }
    RP2040 { aliases "SC0914";  mpns "SC0914(7)" "SC0914(13)" }
    RP2350A { aliases "SC1509";  mpns "SC1509" "SC1509(13)" }
    RP2350B { aliases "SC1510";  mpns "SC1510" "SC1510(13)" }

    // LEDs (Vishay) - Base product confirmed via parts CLI
    VLMB1500 { mpns "VLMB1500-GS08" }
    VLMG1500 { mpns "VLMG1500-GS08" }
    VLMO1500 { mpns "VLMO1500-GS08" }
    VLMS1500 { mpns "VLMS1500-GS08" }

    // Protection Diodes
    PESD5V0X1UB { mpns "PESD5V0X1UB,135" }
    TPD4E05U06QDQARQ1 { mpns "TPD4E05U06QDQARQ1" }

    // Connectors
    USB4105GFA { mpns "USB4105-GF-A" }

    // Switches
    KMR231GLFS { mpns "KMR231G LFS" }

    // LDO Regulators
    TLV75801PDRV { mpns "TLV75801PDRVT" "TLV75801PDRVR" }

    // Flash Memory
    W25Q16JVUXIQ { mpns "W25Q16JVUXIQ TR" }

    // Crystal Oscillators - Frequency is functionally important
    SG210STF12MHz { mpns "SG-210STF 12.0000ML0" }
}

// Resistor series definitions
// Units: power (W), tolerance (decimal), tcr (1/K), temp (°C), resistance (Ω)
resistor-series {
    ERJ2RKF {
        manufacturer "Panasonic Electronic Components"
        package "0402"
        composition "Thick Film"
        power 0.1
        tolerance 0.01
        tcr 100e-6
        temp {
            min -55
            max 155
        }
        aec-q200 0
        standard-values E24 E96
        range 10 1e6
        mpn_template "ERJ-2RKF{value|iec4}X"
    }
    ERJ2RKD {
        manufacturer "Panasonic Electronic Components"
        package "0402"
        composition "Thick Film"
        power 0.1
        tolerance 0.005
        tcr 100e-6
        temp {
            min -55
            max 155
        }
        aec-q200 0
        standard-values E24 E96
        range 10 97.6
        range 102e3 1e6
        mpn_template "ERJ-2RKD{value|iec4}X"
    }
}
